# Copy to .env and adjust if your setup differs.
# The web app connects as the least-privilege login role from review2.sql (Section 10).
# '@' in a password must be URL-encoded as %40.
DATABASE_URL=postgresql://foodlink_web:FoodLinkWeb%402026@localhost:5432/foodlink

# Admin pages (reports, refresh, demo setup) use the DBA login role.
ADMIN_DATABASE_URL=postgresql://foodlink_dba:FoodLinkDba%402026@localhost:5432/foodlink

QDRANT_URL=http://localhost:6333

# Set to 3000 for the two-browser demo: every claim holds the row lock for 3 s.
DEMO_CLAIM_DELAY_MS=0
